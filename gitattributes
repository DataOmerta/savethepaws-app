# Force LF line endings for all text files — prevents Windows CRLF breaking emoji
* text=auto eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.aab binary
*.apk binary
*.keystore binary
